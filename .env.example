# Google Analytics 4 ölçüm ID'si (G-XXXXXXXXXX formatında).
# Tanımlanmadığı sürece Analytics bileşeni hiçbir şey render etmez —
# GA4'te property oluşturup ID'yi buraya (ve deploy ortamındaki env
# değişkenlerine) eklemen yeterli, kod değişikliği gerekmez.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend API anahtarı — form bildirim e-postaları (İletişim, QR Menü demo,
# N8N demo) için. Tanımlanmadığı sürece e-posta gönderilmez, sadece sunucu
# loguna yazılır. resend.com'da hesap açıp bir API key oluşturunca buraya
# (ve deploy ortamındaki env değişkenlerine) eklemen yeterli.
RESEND_API_KEY=

# Form bildirimlerinin gideceği e-posta adresi. Boş bırakılırsa
# literaphy@gmail.com kullanılır (bkz. src/lib/email.ts).
CONTACT_NOTIFY_EMAIL=

# Resend'de doğrulanmış özel bir alan adınız varsa (ör. bildirim@literaphy.com)
# buraya "Ad <adres>" formatında yazın. Boş bırakılırsa Resend'in paylaşımlı
# test alan adı (onboarding@resend.dev) kullanılır — bu da her adrese
# gönderim yapabilir, sadece "Kimden" görünen adı jenerik kalır.
RESEND_FROM_EMAIL=

# ---- /admin yönetim paneli ----------------------------------------------
# Kurulumun tamamı için: docs/admin-panel-kurulum.md

# Oturum çerezini imzalamak için rastgele, en az 32 karakterlik bir metin.
# Üretmek için: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Admin telefon+şifre listesi (opsiyonel). Boş bırakılırsa yerelde
# data/admins.local.json dosyası kullanılır (bkz. `npm run
# admin:create-account`). Production'da (repo public olduğu için) bu env
# değişkenini kullanın — betiğin sonunda yazdırdığı JSON'u buraya yapıştırın:
# [{"phone":"905xxxxxxxxx","passwordHash":"$2a$10$...","name":"Ozan"}]
ADMIN_ACCOUNTS_JSON=

# Sipariş kayıtlarının tutulduğu Google Sheet — servis hesabı kimlik
# bilgileri. Google Cloud Console'da bir servis hesabı oluşturup JSON
# anahtarını indirin, e-postasını sheet'e "Düzenleyen" olarak paylaşın.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# JSON anahtarındaki private_key alanının tamamı (satır başları \n olarak
# kalabilir, kod bunları otomatik gerçek satır sonuna çevirir).
GOOGLE_PRIVATE_KEY=
# Sheet URL'sindeki /d/ ile /edit arasındaki ID (ör. 168fGXez...JiXYR7xV2hY).
GOOGLE_SHEET_ID=
# Sekme (tab) adı — Türkçe Sheets arayüzünde varsayılan "Sayfa1"dir.
GOOGLE_SHEET_NAME=Sayfa1
