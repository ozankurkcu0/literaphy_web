# Google Analytics 4 ölçüm ID'si (G-XXXXXXXXXX formatında).
# Tanımlanmadığı sürece Analytics bileşeni hiçbir şey render etmez —
# GA4'te property oluşturup ID'yi buraya (ve deploy ortamındaki env
# değişkenlerine) eklemen yeterli, kod değişikliği gerekmez.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend API anahtarı — form bildirim e-postaları (İletişim, QR Menü demo,
# N8N demo) için. Tanımlanmadığı sürece e-posta gönderilmez, sadece sunucu
# loguna yazılır. resend.com'da hesap açıp bir API key oluşturunca buraya
# (ve deploy ortamındaki env değişkenlerine) eklemen yeterli.
RESEND_API_KEY=

# Form bildirimlerinin gideceği e-posta adresi. Boş bırakılırsa
# literaphy@gmail.com kullanılır (bkz. src/lib/email.ts).
CONTACT_NOTIFY_EMAIL=

# Resend'de doğrulanmış özel bir alan adınız varsa (ör. bildirim@literaphy.com)
# buraya "Ad <adres>" formatında yazın. Boş bırakılırsa Resend'in paylaşımlı
# test alan adı (onboarding@resend.dev) kullanılır — bu da her adrese
# gönderim yapabilir, sadece "Kimden" görünen adı jenerik kalır.
RESEND_FROM_EMAIL=
